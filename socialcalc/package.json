{
  "name": "socialcalc-ai",
  "version": "1.1.0",
  "description": "Modernized, modular spreadsheet calculation engine and React/Ionic UI suite with AI formula and template capabilities.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspiringsdgs/socialcalc-ai.git",
    "directory": "socialcalc"
  },
  "bugs": {
    "url": "https://github.com/aspiringsdgs/socialcalc-ai/issues"
  },
  "homepage": "https://github.com/aspiringsdgs/socialcalc-ai#readme",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./ionic": {
      "types": "./dist/ionic.d.ts",
      "import": "./dist/ionic.js",
      "default": "./dist/ionic.js"
    },
    "./pdf-export": {
      "types": "./dist/pdf-export.d.ts",
      "import": "./dist/pdf-export.js",
      "default": "./dist/pdf-export.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "import": "./dist/share.js",
      "default": "./dist/share.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm --prefix .. run test:lib",
    "test:smoke": "npm --prefix .. run test:smoke",
    "prepublishOnly": "npm --prefix .. run test:lib && node scripts/build.mjs"
  },
  "keywords": [
    "socialcalc",
    "socialcalc-ai",
    "spreadsheet",
    "react-spreadsheet",
    "ionic-spreadsheet",
    "excel",
    "sheets",
    "calc",
    "formula",
    "msc",
    "pdf",
    "pdf-export",
    "csv",
    "print",
    "email",
    "share",
    "capacitor"
  ],
  "author": "Anirudh Sharma",
  "license": "MIT",
  "dependencies": {
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "peerDependencies": {
    "@ionic/react": ">=7.0.0",
    "html2canvas": ">=1.4.0",
    "ionicons": ">=7.0.0",
    "jspdf": ">=2.5.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@ionic/react": {
      "optional": true
    },
    "ionicons": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "html2canvas": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    }
  }
}

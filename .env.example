# Copy to .env.local (git-ignored via *.local) to override.

# Backend used for Save / Open. "tornado" (default) shows the Login/Open/Save UI;
# "none" hides it and the app stays purely in-memory.
VITE_STORAGE_BACKEND=tornado

# Tornado base URL.
# Empty (default) = relative URLs (/api/...), which the Vite dev proxy forwards to
# http://127.0.0.1:8888 (override with TORNADO_PROXY_TARGET). No CORS needed.
# For a deployed/native build set the absolute URL, e.g. https://sheets.example.com,
# and add this app's origin to ALLOWED_ORIGINS on the Tornado side. Cross-site or
# Capacitor use also needs COOKIE_SAMESITE=None + COOKIE_SECURE=true on Tornado.
VITE_API_BASE_URL=

# Tornado origin that serves /meshkit-helia/* (Helia save/open). Default http://localhost:8080.
# Cross-origin: Tornado must allow this app's origin in its CORS list. Empty = relative URLs via the
# Vite dev proxy (TORNADO_HELIA_PROXY_TARGET, default http://127.0.0.1:8080).
VITE_HELIA_BASE_URL=http://localhost:8080

# Rendered at container start by the nginx image entrypoint (envsubst): only ${VAR} placeholders
# for variables present in the environment are substituted; nginx's own $variables are untouched.
#
#   TORNADO_API_URL           origin of the Tornado backend, no path (e.g. http://nginx:80). REQUIRED.
#   TORNADO_CONNECT_TIMEOUT   seconds to connect to the backend (default 5)    -> 502 when unreachable
#   TORNADO_READ_TIMEOUT      seconds to wait for a response   (default 60)   -> 504 when exceeded
#   NGINX_RESOLVER            DNS server used to resolve the backend at request time
#                             (default 127.0.0.11 = Docker's embedded DNS)
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Tornado caps a sheet at 5 MB (handlers/sheets_api.py); leave room for the JSON envelope.
    client_max_body_size 6m;

    gzip on;
    gzip_min_length 1000;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Resolve the backend per request (not at startup), so this container starts, and reports
    # 502/504 instead of crashing, when the backend is down or restarting.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # Container health: answered by nginx itself, independent of the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Tornado JSON Sheets API (same origin as the UI, so the signed `user` cookie needs no CORS).
    location /api/ {
        set $tornado_upstream "${TORNADO_API_URL}";
        proxy_pass $tornado_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout ${TORNADO_CONNECT_TIMEOUT}s;
        proxy_send_timeout    ${TORNADO_READ_TIMEOUT}s;
        proxy_read_timeout    ${TORNADO_READ_TIMEOUT}s;

        # JSON bodies for errors generated by *this* nginx (backend down / too slow). Errors
        # returned by the backend itself pass through unchanged.
        error_page 502 @api_bad_gateway;
        error_page 504 @api_gateway_timeout;
    }

    location @api_bad_gateway {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 502 '{"error":"backend unreachable"}';
    }

    location @api_gateway_timeout {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 504 '{"error":"backend timed out"}';
    }

    # Content-hashed build output: cache forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # Single-page app: everything else is index.html (never cached, so a new build is picked up).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
    }
}
